<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default stack using TCP for transport.
  This is a good default stack for most cases when you want a reliable cluster
  over a standard TCP/IP network.
-->
<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">
  <TCP bind_addr="${jgroups.bind_addr:SITE_LOCAL}"
       bind_port="${jgroups.bind_port:7800}"
       enable_diagnostics="false"
       thread_naming_pattern="cl"
       send_buf_size="640k"
       sock_conn_timeout="300"
       bundler_type="no-bundler"
       logical_addr_cache_expiration="360000"
       port_range="5"
       thread_pool.min_threads="0"
       thread_pool.max_threads="20"
       thread_pool.keep_alive_time="30000"/>
       
  <TCPPING async_discovery="true"
           initial_hosts="${jgroups.tcpping.initial_hosts:localhost[7800],localhost[7801]}"
           port_range="3"/>
           
  <MERGE3 min_interval="10000"
          max_interval="30000"/>
          
  <FD_SOCK/>
  
  <FD_ALL timeout="9000" interval="3000" timeout_check_interval="1000"/>
  
  <VERIFY_SUSPECT timeout="1500"/>
  
  <pbcast.NAKACK2 use_mcast_xmit="false"
                 discard_delivered_msgs="true"/>
                 
  <UNICAST3/>
  
  <pbcast.STABLE desired_avg_gossip="50000"
                 max_bytes="4M"/>
                 
  <pbcast.GMS print_local_addr="true" join_timeout="2000"/>
  
  <UFC max_credits="4M"
       min_threshold="0.4"/>
       
  <MFC max_credits="4M"
       min_threshold="0.4"/>
       
  <FRAG2 frag_size="60K"/>
  
  <pbcast.STATE_TRANSFER/>
</config>